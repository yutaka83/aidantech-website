<?xml version="1.0" encoding="UTF-8"?>
<extension type="template" client="site">
	<name>lkim3</name>
	<version>1.0.0</version>
	<creationDate>2026-08</creationDate>
	<author>Aidan Technologies</author>
	<authorEmail>hidayati@aidan.my</authorEmail>
	<copyright>(C) 2026 Lembaga Kemajuan Ikan Malaysia</copyright>
	<license>GNU General Public License version 2 or later</license>
	<description>Portal Rasmi LKIM - reka bentuk LKIM-3. Child of Cassiopeia, styled to SPLaSK / MyGovEA expectations, with the mega menu, audience gateways, service grid, gallery strip and agency carousel homepage layout.</description>
	<parent>cassiopeia</parent>
	<inheritable>0</inheritable>
	<files>
		<filename>index.php</filename>
		<filename>megamenu.php</filename>
		<filename>joomla.asset.json</filename>
		<filename>templateDetails.xml</filename>
		<folder>html</folder>
	</files>
	<media destination="templates/site/lkim3" folder="media">
		<folder>css</folder>
		<folder>js</folder>
		<folder>images</folder>
	</media>
	<languages folder="language">
		<language tag="en-GB">en-GB/tpl_lkim3.ini</language>
		<language tag="en-GB">en-GB/tpl_lkim3.sys.ini</language>
		<language tag="ms-MY">ms-MY/tpl_lkim3.ini</language>
	</languages>
	<positions>
		<!-- Cassiopeia inherited positions -->
		<position>topbar</position>
		<position>below-top</position>
		<position>menu</position>
		<position>search</position>
		<position>banner</position>
		<position>top-a</position>
		<position>top-b</position>
		<position>main-top</position>
		<position>main-bottom</position>
		<position>breadcrumbs</position>
		<position>sidebar-left</position>
		<position>sidebar-right</position>
		<position>bottom-a</position>
		<position>bottom-b</position>
		<position>footer</position>
		<position>debug</position>
		<position>error-403</position>
		<position>error-404</position>
		<!-- LKIM portal positions -->
		<position>quicklinks</position>
		<position>announcements</position>
		<position>services</position>
		<position>highlights</position>
		<position>agencies</position>
		<position>social</position>
		<position>footer-a</position>
		<position>footer-b</position>
		<position>footer-c</position>
		<position>footer-d</position>
	</positions>
	<config>
		<fields name="params">
			<fieldset name="basic" label="Portal">
				<field name="logoFile" type="media" schemes="http,https,data,file" validate="url" relative="true"
					default="media/templates/site/lkim3/images/logo.png" label="Logo portal" />
				<field name="jataFile" type="media" schemes="http,https,data,file" validate="url" relative="true" default="" label="Logo Jata Negara / kementerian" />
				<field name="siteTitle" type="text" default="Lembaga Kemajuan Ikan Malaysia" label="Tajuk portal" filter="string" />
				<field name="siteDescription" type="text" default="Kementerian Pertanian dan Keterjaminan Makanan" label="Tagline" filter="string" />
				<field name="fluidContainer" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="Lebar kandungan">
					<option value="0">Statik</option>
					<option value="1">Penuh</option>
				</field>
				<field name="stickyHeader" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer"
					label="Header melekat"
					description="Reka bentuk ini meletakkan header terapung di atas hero. Hidupkan hanya jika header perlu kekal semasa menatal.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="menuSource" type="list" default="design" label="Sumber menu utama"
					description="&quot;Reka bentuk LKIM-3&quot; melukis mega menu terus daripada menu yang dipilih di bawah, tanpa menyentuh kedudukan modul &quot;menu&quot;.">
					<option value="design">Reka bentuk LKIM-3</option>
					<option value="module">Kedudukan modul &quot;menu&quot;</option>
				</field>
				<field name="menuType" type="menu" clientid="0" default="mainmenu" label="Menu" showon="menuSource:design" />
				<field name="utilFaq" type="text" default="/pk-soalan-lazim" filter="string" label="Pautan ikon Soalan Lazim" />
				<field name="utilContact" type="text" default="/pk-hubungi-kami" filter="string" label="Pautan ikon Hubungi" />
				<field name="utilFeedback" type="text" default="/pk-maklum-balas" filter="string" label="Pautan ikon Maklum Balas" />
				<field name="utilSitemap" type="text" default="/pk-peta-laman" filter="string" label="Pautan ikon Peta Laman" />
			</fieldset>
			<fieldset name="homepage" label="Laman Utama">
				<field name="heroImage" type="media" schemes="http,https,data,file" validate="url" relative="true"
					default="media/templates/site/lkim3/images/banner.jpg" label="Imej hero"
					description="Latar penuh bagi hero laman utama. Nisbah lebar disyorkan 1920x1080." />
				<field name="heroAlt" type="text" default="" filter="string" label="Teks alternatif imej hero" />
				<field name="heroTitle" type="text" default="" filter="string"
					label="Tajuk hero"
					description="Kosongkan untuk menggunakan teks lalai dari fail bahasa. Bungkus perkataan dengan {a}...{/a} untuk warna oren." />
				<field name="heroLead" type="textarea" rows="3" default="" filter="string" label="Teks pengenalan hero" />
				<field name="heroCtaText" type="text" default="" filter="string" label="Butang utama hero" />
				<field name="heroCtaLink" type="text" default="/pk-maklum-balas" filter="string" label="Pautan butang utama" />
				<field name="heroCta2Text" type="text" default="" filter="string" label="Butang kedua hero" />
				<field name="heroCta2Link" type="text" default="/k-perkhidmatan" filter="string" label="Pautan butang kedua" />

				<field name="bandSourceNote" type="note" class="alert alert-info"
					label="Sumber kandungan jalur"
					description="Setiap jalur laman utama boleh mengambil kandungan dari reka bentuk LKIM-3 (tetapan di bawah) atau dari kedudukan modulnya. Lalai ialah reka bentuk, supaya laman utama sepadan dengan mockup sebaik dipasang." />

				<field name="showGateways" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Kad khalayak (bertindih hero)">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcGateways" type="list" default="design" label="Sumber kad khalayak"
					showon="showGateways:1">
					<option value="design">Reka bentuk LKIM-3</option>
					<option value="module">Kedudukan modul &quot;quicklinks&quot;</option>
				</field>
				<field name="gateway1Link" type="text" default="/k-perkhidmatan" filter="string" label="Pautan kad 1 (Umum / Orang Awam)" />
				<field name="gateway2Link" type="text" default="/k-perkhidmatan-bantuan-masyarakat-nelayan" filter="string" label="Pautan kad 2 (Pembangunan Nelayan)" />
				<field name="gateway3Link" type="text" default="/k-info-lkim-organisasi" filter="string" label="Pautan kad 3 (Keluarga LKIM)" />

				<field name="showServices" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Bahagian perkhidmatan"
					description="Kad utama beserta empat kad sokongan.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcServices" type="list" default="design" label="Sumber perkhidmatan" showon="showServices:1">
					<option value="design">Reka bentuk LKIM-3</option>
					<option value="module">Kedudukan modul &quot;services&quot;</option>
				</field>
				<field name="servicesMoreLink" type="text" default="/k-perkhidmatan" filter="string" label="Pautan &quot;Lihat Semua Perkhidmatan&quot;" />
				<field name="featureLink" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/bantuan-sara-hidup-nelayan" filter="string" label="Pautan butang kad perkhidmatan utama" />
				<field name="svcLink1" type="text" default="/k-perkhidmatan-pemasaran-ikan" filter="string" label="Pautan kad: Pasaran &amp; Pendapatan" />
				<field name="svcLink2" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/dana-nelayan" filter="string" label="Pautan kad: Dana Nelayan" />
				<field name="svcLink3" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/skim-keselamatan-sosial-pekerjaan-sendiri-sksps" filter="string" label="Pautan kad: Skim Keselamatan Sosial" />
				<field name="svcLink4" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/projek-khas-perumahan-nelayan-2" filter="string" label="Pautan kad: Perumahan Nelayan" />

				<field name="showGallery" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Ruang sosial (jalur galeri)">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcGallery" type="list" default="design" label="Sumber galeri" showon="showGallery:1">
					<option value="design">Reka bentuk LKIM-3</option>
					<option value="module">Kedudukan modul &quot;highlights&quot;</option>
				</field>
				<field name="facebookUrl" type="url" default="" filter="url" label="URL Facebook" />
				<field name="youtubeUrl" type="url" default="" filter="url" label="URL YouTube" />
				<field name="twitterUrl" type="url" default="" filter="url" label="URL X / Twitter" />
				<field name="instagramUrl" type="url" default="" filter="url" label="URL Instagram" />

				<field name="showNews" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Berita &amp; pengumuman">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcNews" type="list" default="design" label="Sumber berita" showon="showNews:1"
					description="&quot;Reka bentuk LKIM-3&quot; memaparkan tiga artikel terbaharu portal dalam kad reka bentuk ini.">
					<option value="design">Reka bentuk LKIM-3</option>
					<option value="module">Kedudukan modul &quot;announcements&quot;</option>
				</field>
				<field name="newsMoreLink" type="text" default="/k-berita" filter="string" label="Pautan &quot;Lihat Semua Berita&quot;" />

				<field name="showAgencies" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Karusel agensi berkaitan">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcAgencies" type="list" default="design" label="Sumber agensi" showon="showAgencies:1">
					<option value="design">Reka bentuk LKIM-3</option>
					<option value="module">Kedudukan modul &quot;agencies&quot;</option>
				</field>

				<field name="showCta" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Sepanduk aduan">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="ctaLink" type="text" default="/pk-maklum-balas" filter="string" label="Pautan &quot;Hantar Aduan&quot;" />
				<field name="ctaLink2" type="text" default="/pk-maklum-balas" filter="string" label="Pautan &quot;Semak Status Aduan&quot;" />
			</fieldset>
			<fieldset name="splask" label="SPLaSK / MyGovEA">
				<field name="showGovBanner" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Pengenalan portal rasmi kerajaan"
					description="Bar &quot;Portal Rasmi Kerajaan Malaysia&quot; dengan teks rasmi JDN / MyGovEA.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="showAccessBar" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="Bar kebolehaksesan (saiz teks + kontras)">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="showLastUpdate" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="Papar tarikh kemas kini">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="showVisitorCounter" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="Papar kaunter pelawat">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="splaskAttribute" type="text" default="data-splask" label="Atribut penanda SPLaSK"
					description="Nama atribut HTML yang digunakan untuk menanda elemen SPLaSK. Tukar kepada nama yang ditetapkan dalam pekeliling semasa jika berbeza." />
				<field name="showFooterContact" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Lajur &quot;Hubungi Kami&quot; dalam pengaki"
					description="Lajur alamat terbina dalam, dengan penanda SPLaSK. Matikan jika modul pengaki sudah menyenaraikan alamat yang sama.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="agencyAddress" type="textarea" rows="4"
					default="Aras 1-12, Wisma LKIM, Pulau Meranti, 47120 Puchong, Selangor" label="Alamat agensi" filter="raw" />
				<field name="agencyPhone" type="text" default="03-8942 2745" label="Telefon" />
				<field name="agencyFax" type="text" default="" label="Faks" />
				<field name="agencyEmail" type="text" default="info@lkim.gov.my" label="E-mel" />
				<field name="legalTerms" type="text" default="/pk-terma-syarat" filter="string" label="Pautan Terma &amp; Syarat" />
				<field name="legalPrivacy" type="text" default="/pk-dasar-privasi" filter="string" label="Pautan Dasar Privasi" />
				<field name="legalSecurity" type="text" default="/pk-dasar-keselamatan" filter="string" label="Pautan Dasar Keselamatan ICT" />
				<field name="legalDisclaimer" type="text" default="/pk-penafian" filter="string" label="Pautan Penafian" />
			</fieldset>
			<fieldset name="advanced" label="JGLOBAL_FIELDSET_ADVANCED">
				<field name="backTop" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="TPL_CASSIOPEIA_BACKTOTOP_LABEL">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="customcode" label="Kod Tersuai">
				<field name="customCodeNote" type="note" class="alert alert-warning"
					label="Kod ini dimuatkan pada setiap halaman"
					description="Kandungan dua medan di bawah dikeluarkan ke halaman apa adanya, tanpa penapisan. Hadkan kebenaran &quot;Edit&quot; bagi com_templates kepada Super User sahaja. Untuk perubahan yang lebih besar, gunakan fail user.css / user.js di bawah supaya kod itu kekal dalam kawalan versi." />

				<field name="customCss" type="textarea" rows="12" filter="raw" default="" label="CSS tersuai"
					description="Dimuatkan selepas lkim3.css, jadi ia mengatasi gaya templat tanpa perlu !important. Jangan sertakan tag &lt;style&gt;." />

				<field name="customJs" type="textarea" rows="12" filter="raw" default="" label="JavaScript tersuai"
					description="Jangan sertakan tag &lt;script&gt;, dan elakkan rentetan yang mengandungi &lt;/script&gt;." />

				<field name="customJsPosition" type="list" default="body" label="Kedudukan JavaScript tersuai"
					description="&quot;Hujung body&quot; berjalan selepas halaman dilukis dan selamat untuk kebanyakan kod. Pilih &quot;head&quot; hanya untuk kod yang mesti berjalan lebih awal, seperti tag pengukuran.">
					<option value="body">Hujung body</option>
					<option value="head">Dalam head</option>
				</field>

				<field name="useUserFiles" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Muatkan user.css / user.js"
					description="Jika ada, muatkan media/templates/site/lkim3/css/user.css dan js/user.js. Fail yang tiada diabaikan senyap.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
