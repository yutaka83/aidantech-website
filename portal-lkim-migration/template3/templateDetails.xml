<?xml version="1.0" encoding="UTF-8"?>
<extension type="template" client="site">
	<name>lkim3</name>
	<version>1.0.0</version>
	<creationDate>2026-08</creationDate>
	<author>Aidan Technologies</author>
	<authorEmail>hidayati@aidan.my</authorEmail>
	<copyright>(C) 2026 Lembaga Kemajuan Ikan Malaysia</copyright>
	<license>GNU General Public License version 2 or later</license>
	<description>Portal Rasmi LKIM - reka bentuk LKIM-3. Child of Cassiopeia, styled to SPLaSK / MyGovEA expectations, with the mega menu, audience gateways, service grid, gallery strip and agency carousel homepage layout.</description>
	<parent>cassiopeia</parent>
	<inheritable>0</inheritable>
	<files>
		<filename>index.php</filename>
		<filename>megamenu.php</filename>
		<filename>joomla.asset.json</filename>
		<filename>templateDetails.xml</filename>
		<folder>html</folder>
	</files>
	<media destination="templates/site/lkim3" folder="media">
		<folder>css</folder>
		<folder>js</folder>
		<folder>images</folder>
	</media>
	<languages folder="language">
		<language tag="en-GB">en-GB/tpl_lkim3.ini</language>
		<language tag="en-GB">en-GB/tpl_lkim3.sys.ini</language>
		<language tag="ms-MY">ms-MY/tpl_lkim3.ini</language>
	</languages>
	<positions>
		<!-- Cassiopeia inherited positions -->
		<position>topbar</position>
		<position>below-top</position>
		<position>menu</position>
		<position>search</position>
		<position>banner</position>
		<position>top-a</position>
		<position>top-b</position>
		<position>main-top</position>
		<position>main-bottom</position>
		<position>breadcrumbs</position>
		<position>sidebar-left</position>
		<position>sidebar-right</position>
		<position>bottom-a</position>
		<position>bottom-b</position>
		<position>footer</position>
		<position>debug</position>
		<position>error-403</position>
		<position>error-404</position>
		<!-- LKIM portal positions -->
		<position>quicklinks</position>
		<position>announcements</position>
		<position>services</position>
		<position>highlights</position>
		<position>agencies</position>
		<position>social</position>
		<position>footer-a</position>
		<position>footer-b</position>
		<position>footer-c</position>
		<position>footer-d</position>
	</positions>
	<config>
		<fields name="params">
			<fieldset name="basic" label="Portal">
				<field name="logoFile" type="media" schemes="http,https,data,file" validate="url" relative="true"
					default="media/templates/site/lkim3/images/logo.png" label="Portal logo" />
				<field name="jataFile" type="media" schemes="http,https,data,file" validate="url" relative="true" default="" label="Jata Negara / ministry crest" />
				<field name="siteTitle" type="text" default="Lembaga Kemajuan Ikan Malaysia" label="Portal title" filter="string" />
				<field name="siteDescription" type="text" default="Kementerian Pertanian dan Keterjaminan Makanan" label="Tagline" filter="string" />
				<field name="fluidContainer" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="Content width">
					<option value="0">Fixed</option>
					<option value="1">Full width</option>
				</field>
				<field name="stickyHeader" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer"
					label="Sticky header"
					description="This design floats the header over the hero. Turn this on only if the header must stay visible while scrolling.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="menuSource" type="list" default="design" label="Main menu source"
					description="&quot;LKIM-3 design&quot; draws the mega menu straight from the menu selected below, leaving the &quot;menu&quot; module position untouched.">
					<option value="design">LKIM-3 design</option>
					<option value="module">&quot;menu&quot; module position</option>
				</field>
				<field name="menuType" type="menu" clientid="0" default="mainmenu" label="Menu" showon="menuSource:design" />
				<field name="utilFaq" type="text" default="/pk-soalan-lazim" filter="string" label="FAQ icon link" />
				<field name="utilContact" type="text" default="/pk-hubungi-kami" filter="string" label="Contact icon link" />
				<field name="utilFeedback" type="text" default="/pk-maklum-balas" filter="string" label="Feedback icon link" />
				<field name="utilSitemap" type="text" default="/pk-peta-laman" filter="string" label="Sitemap icon link" />
			</fieldset>
			<fieldset name="homepage" label="Homepage">
				<field name="heroImage" type="media" schemes="http,https,data,file" validate="url" relative="true"
					default="media/templates/site/lkim3/images/banner.jpg" label="Hero image"
					description="Full-bleed background for the homepage hero. 1920x1080 or wider is recommended." />
				<field name="heroAlt" type="text" default="" filter="string" label="Hero image alt text" />
				<field name="heroTitle" type="text" default="" filter="string"
					label="Hero heading"
					description="Leave empty to use the default from the language file. Wrap words in {a}...{/a} for the orange accent, and use {br} to force a line break." />
				<field name="heroLead" type="textarea" rows="3" default="" filter="string" label="Hero intro text" />
				<field name="heroCtaText" type="text" default="" filter="string" label="Hero primary button" />
				<field name="heroCtaLink" type="text" default="/pk-maklum-balas" filter="string" label="Primary button link" />
				<field name="heroCta2Text" type="text" default="" filter="string" label="Hero secondary button" />
				<field name="heroCta2Link" type="text" default="/k-perkhidmatan" filter="string" label="Secondary button link" />

				<field name="bandSourceNote" type="note" class="alert alert-info"
					label="Where each band gets its content"
					description="Every homepage band can draw its content either from the LKIM-3 design (the settings below) or from its module position. The design is the default, so the homepage matches the mockup as soon as the template is installed." />

				<field name="showGateways" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Audience cards (overlapping the hero)">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcGateways" type="list" default="design" label="Audience card source"
					showon="showGateways:1">
					<option value="design">LKIM-3 design</option>
					<option value="module">&quot;quicklinks&quot; module position</option>
				</field>
				<field name="gateway1Link" type="text" default="/k-perkhidmatan" filter="string" label="Card 1 link (Umum / Orang Awam)" />
				<field name="gateway2Link" type="text" default="/k-perkhidmatan-bantuan-masyarakat-nelayan" filter="string" label="Card 2 link (Pembangunan Nelayan)" />
				<field name="gateway3Link" type="text" default="/k-info-lkim-organisasi" filter="string" label="Card 3 link (Keluarga LKIM)" />

				<field name="showServices" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Services section"
					description="One feature card plus four supporting cards.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcServices" type="list" default="design" label="Services source" showon="showServices:1">
					<option value="design">LKIM-3 design</option>
					<option value="module">&quot;services&quot; module position</option>
				</field>
				<field name="servicesMoreLink" type="text" default="/k-perkhidmatan" filter="string" label="&quot;View all services&quot; link" />
				<field name="featureLink" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/bantuan-sara-hidup-nelayan" filter="string" label="Feature card button link" />
				<field name="svcLink1" type="text" default="/k-perkhidmatan-pemasaran-ikan" filter="string" label="Card link: Pasaran &amp; Pendapatan" />
				<field name="svcLink2" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/dana-nelayan" filter="string" label="Card link: Dana Nelayan" />
				<field name="svcLink3" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/skim-keselamatan-sosial-pekerjaan-sendiri-sksps" filter="string" label="Card link: Skim Keselamatan Sosial" />
				<field name="svcLink4" type="text" default="/perkhidmatan/bantuan-kepada-masyarakat-nelayan/projek-khas-perumahan-nelayan-2" filter="string" label="Card link: Perumahan Nelayan" />

				<field name="showGallery" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Social space (gallery strip)">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcGallery" type="list" default="design" label="Gallery source" showon="showGallery:1">
					<option value="design">LKIM-3 design</option>
					<option value="module">&quot;highlights&quot; module position</option>
				</field>
				<field name="facebookUrl" type="url" default="" filter="url" label="Facebook URL" />
				<field name="youtubeUrl" type="url" default="" filter="url" label="YouTube URL" />
				<field name="twitterUrl" type="url" default="" filter="url" label="X / Twitter URL" />
				<field name="instagramUrl" type="url" default="" filter="url" label="Instagram URL" />

				<field name="showNews" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="News &amp; announcements">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcNews" type="list" default="design" label="News source" showon="showNews:1"
					description="&quot;LKIM-3 design&quot; shows the portal's three most recent articles in this design's cards.">
					<option value="design">LKIM-3 design</option>
					<option value="module">&quot;announcements&quot; module position</option>
				</field>
				<field name="newsMoreLink" type="text" default="/k-berita" filter="string" label="&quot;View all news&quot; link" />

				<field name="showAgencies" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Related agency carousel">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="srcAgencies" type="list" default="design" label="Agency source" showon="showAgencies:1">
					<option value="design">LKIM-3 design</option>
					<option value="module">&quot;agencies&quot; module position</option>
				</field>

				<field name="showCta" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Complaints banner">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="ctaLink" type="text" default="/pk-maklum-balas" filter="string" label="&quot;Submit a complaint&quot; link" />
				<field name="ctaLink2" type="text" default="/pk-maklum-balas" filter="string" label="&quot;Check complaint status&quot; link" />
			</fieldset>
			<fieldset name="splask" label="SPLaSK / MyGovEA">
				<field name="showGovBanner" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Government portal identification bar"
					description="The &quot;Portal Rasmi Kerajaan Malaysia&quot; bar, with the official JDN / MyGovEA wording.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="showAccessBar" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Accessibility controls (text size + contrast)"
					description="Shown in the header behind the accessibility icon.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="showLastUpdate" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="Show last-updated date">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="showVisitorCounter" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="Show visitor counter">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="splaskAttribute" type="text" default="data-splask" label="SPLaSK marker attribute"
					description="The HTML attribute name used to mark SPLaSK elements. Change it to whatever the current circular specifies if that differs." />
				<field name="showFooterContact" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="&quot;Contact us&quot; column in the footer"
					description="The built-in address column, which carries the SPLaSK markers. Turn it off if a footer module already lists the same address.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="agencyAddress" type="textarea" rows="4"
					default="Aras 1-12, Wisma LKIM, Pulau Meranti, 47120 Puchong, Selangor" label="Agency address" filter="raw" />
				<field name="agencyPhone" type="text" default="03-8942 2745" label="Telephone" />
				<field name="agencyFax" type="text" default="" label="Fax" />
				<field name="agencyEmail" type="text" default="info@lkim.gov.my" label="Email" />
				<field name="legalTerms" type="text" default="/pk-terma-syarat" filter="string" label="Terms &amp; conditions link" />
				<field name="legalPrivacy" type="text" default="/pk-dasar-privasi" filter="string" label="Privacy policy link" />
				<field name="legalSecurity" type="text" default="/pk-dasar-keselamatan" filter="string" label="ICT security policy link" />
				<field name="legalDisclaimer" type="text" default="/pk-penafian" filter="string" label="Disclaimer link" />
			</fieldset>
			<fieldset name="advanced" label="JGLOBAL_FIELDSET_ADVANCED">
				<field name="backTop" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="TPL_CASSIOPEIA_BACKTOTOP_LABEL">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="customcode" label="Custom Code">
				<field name="customCodeNote" type="note" class="alert alert-warning"
					label="This code runs on every page"
					description="Both fields below are written to the page exactly as entered, with no filtering. Keep &quot;Edit&quot; permission on com_templates with Super Users only. For anything substantial, use the user.css / user.js files below so the code stays under version control." />

				<field name="customCss" type="textarea" rows="12" filter="raw" default="" label="Custom CSS"
					description="Loaded after lkim3.css, so it overrides the template without needing !important. Do not include &lt;style&gt; tags." />

				<field name="customJs" type="textarea" rows="12" filter="raw" default="" label="Custom JavaScript"
					description="Do not include &lt;script&gt; tags, and avoid strings containing &lt;/script&gt;." />

				<field name="customJsPosition" type="list" default="body" label="Custom JavaScript position"
					description="&quot;End of body&quot; runs after the page is drawn and is right for almost all code. Choose &quot;In head&quot; only for code that must run earlier, such as a measurement tag.">
					<option value="body">End of body</option>
					<option value="head">In head</option>
				</field>

				<field name="useUserFiles" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
					label="Load user.css / user.js"
					description="Loads media/templates/site/lkim3/css/user.css and js/user.js when they exist. Missing files are skipped silently.">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
